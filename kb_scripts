#       COMPANY:  
#       VERSION:  1.0
#       CREATED:  09/03/2009 04:33:43 PM IDT
#      REVISION:  ---
#===============================================================================

if [ "$1" = "-c" ]; then
    COMMENT='yes';
    shift;
else
    COMMENT='no';
fi

if [ "$COMMENT" = "yes" ]; then
    sed -i "/$1/,/^$/s/^[^#]/#&/g" "$2"
else
    sed -i "/$1/,/^$/s/^#\+//g" "$2"
#add an extra # to comment line b/c it should stay commented
    sed -i "s/$1/#$1/" "$2"
fi

